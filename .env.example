# Public ports
GATEWAY_PORT=8080
CONSUL_HTTP_PORT=8500
RABBITMQ_MANAGEMENT_PORT=15672

# Shared HTTP server settings
HTTP_SHUTDOWN_TIMEOUT=10s
CONSUL_TIMEOUT=3s
UPSTREAM_TIMEOUT=5s
DATABASE_TIMEOUT=5s
LAND_PLOT_SERVICE_NAME=land-plot-service
RABBITMQ_TIMEOUT=5s
MESSAGE_PROCESSING_TIMEOUT=5s
RABBITMQ_PREFETCH=10

# Authentication (replace for any non-local environment)
JWT_SECRET=local_development_jwt_secret_change_me
JWT_TTL=1h
BCRYPT_COST=12

# PostgreSQL bootstrap administrator
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_password
POSTGRES_ADMIN_DB=postgres

# Service-owned database credentials
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_dev_password
PLOT_DB_NAME=plot_db
PLOT_DB_USER=plot_user
PLOT_DB_PASSWORD=plot_dev_password
REPORT_DB_NAME=report_db
REPORT_DB_USER=report_user
REPORT_DB_PASSWORD=report_dev_password

# RabbitMQ local development credentials
RABBITMQ_USER=land_app
RABBITMQ_PASSWORD=rabbitmq_dev_password
