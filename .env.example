# Public ports
GATEWAY_PORT=8080
CONSUL_HTTP_PORT=8500
RABBITMQ_MANAGEMENT_PORT=15672

# Shared HTTP server settings
HTTP_SHUTDOWN_TIMEOUT=10s
CONSUL_TIMEOUT=3s
UPSTREAM_TIMEOUT=5s
DATABASE_TIMEOUT=5s
LAND_PLOT_SERVICE_NAME=land-plot-service
RABBITMQ_TIMEOUT=5s
MESSAGE_PROCESSING_TIMEOUT=5s
RABBITMQ_PREFETCH=10

# Transactional Outbox and SAGA
OUTBOX_POLL_INTERVAL=1s
# rejections by the broker (unroutable or nack) before an outbox row gets failed_at
OUTBOX_MAX_ATTEMPTS=10
# how often published rows older than OUTBOX_RETENTION are deleted; failed rows are kept
OUTBOX_CLEANUP_INTERVAL=1m
OUTBOX_RETENTION=1h
SAGA_TIMEOUT=30s
# report-service fails to write plot summaries whose name starts with this prefix; empty disables it
REPORT_FAIL_NAME_PREFIX=FAIL
# Open-Meteo endpoints for the terrain and climate blocks of a report; an unreachable URL makes them unavailable
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT=3s


# PostgreSQL port on localhost, used by make test-integration
POSTGRES_PORT=55432

# PostgreSQL bootstrap administrator
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_password
POSTGRES_ADMIN_DB=postgres

# Service-owned database credentials
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_dev_password
PLOT_DB_NAME=plot_db
PLOT_DB_USER=plot_user
PLOT_DB_PASSWORD=plot_dev_password
REPORT_DB_NAME=report_db
REPORT_DB_USER=report_user
REPORT_DB_PASSWORD=report_dev_password

# RabbitMQ local development credentials
RABBITMQ_USER=land_app
RABBITMQ_PASSWORD=rabbitmq_dev_password

# AI agents (Lab 4)
# free key from https://aistudio.google.com/apikey; keep it only in .env
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=1024
# thinking level for -mode reasoning: low, medium or high; -mode non-reasoning always uses minimal
LLM_THINKING_LEVEL=high
# pause between model calls to stay within the free tier requests per minute
LLM_MIN_INTERVAL=6s
LLM_REQUEST_TIMEOUT=1m
AGENT_TOKEN_BUDGET=30000
AGENT_MAX_STEPS=8
USER_INPUT_MAX_CHARS=2000
TOOL_RESULT_MAX_BYTES=4000
# gateway address for agents started on the host; containers use http://api-gateway:8080
GATEWAY_URL=http://localhost:8080
GATEWAY_TIMEOUT=10s
# AI programs on the host get tokens through client credentials of land-plot-ai (AI_CLIENT_SECRET is set in the Keycloak section)
OIDC_TOKEN_URL=http://localhost:8180/realms/land-plot/protocol/openid-connect/token
AI_CLIENT_ID=land-plot-ai
# scopes for fc-client and mcp-server on the host; docker-compose gives each agent only the scopes it needs
AI_SCOPES=plots:read plots:write reports:read reports:write
# static token for the MCP server over HTTP, at least 32 characters (openssl rand -hex 32)
MCP_ACCESS_TOKEN=
MCP_RATE_LIMIT_PER_MINUTE=30
A2A_CALL_TIMEOUT=90s

# Web origins allowed by the gateway CORS policy (exact match, comma separated)
CORS_ALLOWED_ORIGINS=https://cad.kpi.ua,http://localhost:5173,http://localhost:4173
# Public POST /api/v1/plots/preview: requests per minute from one IP address
PREVIEW_RATE_LIMIT_PER_MINUTE=120

# Keycloak (Lab 5): authorization server on http://localhost:8180
KEYCLOAK_PORT=8180
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_dev_password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=keycloak_admin_dev_password
# passwords of the test users olena.koval@example.com (OTP required) and taras.melnyk@example.com
OLENA_KOVAL_PASSWORD=OlenaDevPassword123
TARAS_MELNYK_PASSWORD=TarasDevPassword123
# secret of the confidential client land-plot-ai used by the AI agents
AI_CLIENT_SECRET=local_development_ai_client_secret

# Mailpit catches Keycloak emails (password reset); web interface on this port, no SMTP password
MAILPIT_UI_PORT=8025
# Google login: OAuth client of type Web application, redirect URI http://localhost:8180/realms/land-plot/broker/google/endpoint
# keep the values only in .env and run ./scripts/keycloak_idp.sh after Keycloak starts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web app container (http://localhost:4173). VITE_* values are built into the bundle, so they must never hold secrets;
# the CSP origins must match them.
WEB_PORT=4173
WEB_GATEWAY_URL=http://localhost:8080
WEB_OIDC_AUTHORITY=http://localhost:8180/realms/land-plot
WEB_CSP_GATEWAY_ORIGIN=http://localhost:8080
WEB_CSP_KEYCLOAK_ORIGIN=http://localhost:8180

# Observability stack: docker compose --profile observability up -d (every UI listens on 127.0.0.1 only)
PROMETHEUS_PORT=19090
PROMETHEUS_RETENTION=7d
ALERTMANAGER_PORT=19093
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
# REQUIRED, also without --profile observability: docker compose refuses every command (up, config, demos)
# when GRAFANA_ADMIN_PASSWORD is missing. Replace the placeholder in .env, for example with openssl rand -hex 16.
GRAFANA_ADMIN_PASSWORD=change-me
JAEGER_UI_PORT=16686
JAEGER_RETENTION=72h
# where the Go services send their traces (OTLP over HTTP); empty turns tracing off
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTLP receivers of the collector for programs started on the host
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
