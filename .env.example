# Public ports
GATEWAY_PORT=8080
CONSUL_HTTP_PORT=8500
RABBITMQ_MANAGEMENT_PORT=15672

# Shared HTTP server settings
HTTP_SHUTDOWN_TIMEOUT=10s
CONSUL_TIMEOUT=3s
UPSTREAM_TIMEOUT=5s
DATABASE_TIMEOUT=5s
LAND_PLOT_SERVICE_NAME=land-plot-service
RABBITMQ_TIMEOUT=5s
MESSAGE_PROCESSING_TIMEOUT=5s
RABBITMQ_PREFETCH=10

# Transactional Outbox and SAGA
OUTBOX_POLL_INTERVAL=1s
# rejections by the broker (unroutable or nack) before an outbox row gets failed_at
OUTBOX_MAX_ATTEMPTS=10
# how often published rows older than OUTBOX_RETENTION are deleted; failed rows are kept
OUTBOX_CLEANUP_INTERVAL=1m
OUTBOX_RETENTION=1h
SAGA_TIMEOUT=30s
# report-service fails to write plot summaries whose name starts with this prefix; empty disables it
REPORT_FAIL_NAME_PREFIX=FAIL

# Authentication (replace for any non-local environment)
JWT_SECRET=local_development_jwt_secret_change_me
JWT_TTL=1h
BCRYPT_COST=12

# PostgreSQL port on localhost, used by make test-integration
POSTGRES_PORT=55432

# PostgreSQL bootstrap administrator
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_password
POSTGRES_ADMIN_DB=postgres

# Service-owned database credentials
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_dev_password
PLOT_DB_NAME=plot_db
PLOT_DB_USER=plot_user
PLOT_DB_PASSWORD=plot_dev_password
REPORT_DB_NAME=report_db
REPORT_DB_USER=report_user
REPORT_DB_PASSWORD=report_dev_password

# RabbitMQ local development credentials
RABBITMQ_USER=land_app
RABBITMQ_PASSWORD=rabbitmq_dev_password
